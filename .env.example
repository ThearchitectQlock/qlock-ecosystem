# ═══════════════════════════════════════════════════════════════════════
# Q-Lock ecosystem — environment
#
#   cp .env.example .env      then fill in real values. Never commit .env.
#
# Grouped by service. docker-compose.yml passes each service only what it
# needs. Secrets have no defaults anywhere in the code: a default secret
# in a binary is a published secret.
# ═══════════════════════════════════════════════════════════════════════

# ── Shared ─────────────────────────────────────────────────────────────
RUST_LOG=info

# ───────────────────────────────────────────────────────────────────────
# DATA — Postgres and Redis (internal network only)
# ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
DB_PASSWORD=change-me-db-password
REDIS_PASSWORD=change-me-redis-password

# Compose builds the escrow's DATABASE_URL from DB_PASSWORD. Set this
# only for `cargo run` outside Docker (host is localhost there).
DATABASE_URL=postgresql://qlock:change-me-db-password@localhost:5432/qlock

# ───────────────────────────────────────────────────────────────────────
# Q-LOCK ESCROW  (crates/qlock-escrow)
# ───────────────────────────────────────────────────────────────────────
# development | production. Production refuses to start without a
# persistent attestation identity.
QLOCK_ENV=development

# Signs login tokens. openssl rand -hex 32
JWT_SECRET=

# Your XRPL address (r...) that receives the platform escrow fee. Without
# it escrow creation returns 503 rather than letting the fee vanish.
QLOCK_TREASURY_ADDRESS=rdyZMSbKDPwsa75JiWbNnjYyNBr7BhaE2

# HTTPS JSON-RPC endpoint (not wss://).
#   Testnet: https://s.altnet.rippletest.net:51234
#   Mainnet: https://xrplcluster.com
XRPL_NODE=https://s.altnet.rippletest.net:51234

# Xaman (Xumm) developer credentials — https://apps.xumm.dev
# Without both, /wallet/xumm/* returns 503 instead of faking a connection.
XUMM_API_KEY=
XUMM_API_SECRET=

# Persistent Dilithium5 attestation identity: the keypair JSON from
#   godshield vault recover --vault qlock_attestation_vault.json ...
# injected by your secrets manager. Its fingerprint is what you publish
# so anyone can verify an attestation is Q-Lock's.
QLOCK_ATTESTATION_KEY=

# Comma-separated CORS allowlist for the escrow API.
FRONTEND_ORIGIN=https://q-lock-ecosystem.com,http://localhost

# Stripe — https://dashboard.stripe.com
STRIPE_SECRET_KEY=
# The endpoint's signing secret (whsec_...). Every webhook is verified
# against it with HMAC-SHA256 and a 5-minute replay window.
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) of the recurring prices you created in Stripe.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# What the website shows next to each plan, e.g. "£29/month". Must match
# the Stripe price above — Stripe charges its price, this is just the label.
STRIPE_PRICE_LABEL_PRO=
STRIPE_PRICE_LABEL_ENTERPRISE=

# Optional error reporting. Blank disables it.
SENTRY_DSN=

# ───────────────────────────────────────────────────────────────────────
# NEV369 NODE  (crates/nev369-node)
# ───────────────────────────────────────────────────────────────────────
# development | production. Production refuses placeholder premine
# addresses, '*' CORS, and disables /mine and /wallet/new.
NEV369_ENV=development

# Genesis premine recipients — the public_key_hex printed by
#   make vault-architect          (10,000,000 NEV, spendable)
#   make vault-nevaeh-nev369      (36,900,000 NEV, locked to 2039-07-28)
# Blank = development placeholders. Pinned into genesis forever once the
# chain starts; every node must use the same values.
NEV369_ARCHITECT_ADDRESS=
NEV369_NEVAEH_VAULT_ADDRESS=
# Pinned genesis. Every node on NEV369 mainnet uses the values published in
# chain-spec/nev369-mainnet.env, so all nodes build the identical block 0.
# Blank = found a brand-new network (development only). Required in production.
NEV369_GENESIS_TIMESTAMP=
NEV369_GENESIS_HASH=

# Background miner. The reward address is a hex Dilithium5 public key.
NEV369_MINING=0
NEV369_MINER_ADDRESS=
# POST /mine for one-off blocks. Defaults on outside production.
NEV369_HTTP_MINING=

NEV369_DB_PATH=./data/nev369.db
NEV369_BIND_ADDR=0.0.0.0
NEV369_BIND_PORT=8080
NEV369_P2P_PORT=4001
# Comma-separated multiaddrs. Miners joining the public network use
# /dns4/q-lock-ecosystem.com/tcp/4001 (see docs/MINING.md). Blank on the first node.
NEV369_BOOTSTRAP_PEERS=
NEV369_ALLOWED_ORIGINS=https://q-lock-ecosystem.com,http://localhost,http://localhost:3000
NEV369_TX_RATE_LIMIT=60
NEV369_MINE_RATE_LIMIT=6

# ───────────────────────────────────────────────────────────────────────
# ETH BRIDGE — COORDINATOR  (crates/nev369-relayer, profile: bridge)
# ───────────────────────────────────────────────────────────────────────
# The coordinator holds NO signing key. It collects attestations from
# independent signers and authorizes a mint only when BRIDGE_THRESHOLD of
# them agree on byte-identical terms, past finality, inside the limits.

# Authenticates attestation submission (transport only, not mint
# authority). At least 32 characters: openssl rand -hex 32
RELAYER_KEY=

# Comma-separated TripleHash fingerprints of the signing keys. Separate
# keys, on separate infrastructure, run by separate people.
BRIDGE_SIGNERS=
# How many must agree. Refused below 2.
BRIDGE_THRESHOLD=3
# Confirmations before a NEV369 block counts as final (60 ≈ 1 hour).
BRIDGE_FINALITY=60
# Exposure limits in NEV369 base units (8 decimals):
# 100,000 / 1,000,000 per window / 10,000,000 total NEV.
BRIDGE_PER_MINT_CAP=10000000000000
BRIDGE_WINDOW_CAP=100000000000000
BRIDGE_WINDOW_SECONDS=86400
BRIDGE_TOTAL_CAP=1000000000000000
BRIDGE_POLICY_ID=bridge-v1
RELAYER_BIND=0.0.0.0:9370
RELAYER_STORE=./data/relayer.json
RELAYER_ALLOWED_ORIGINS=https://q-lock-ecosystem.com,http://localhost

# EIP-712 domain — must match the deployed NEV369Bridge exactly.
# 1 = Ethereum mainnet, 11155111 = Sepolia.
ETH_CHAIN_ID=11155111
BRIDGE_ADDRESS=

# ───────────────────────────────────────────────────────────────────────
# ETH BRIDGE — SUBMITTER  (crates/nev369-submitter, profile: bridge)
# ───────────────────────────────────────────────────────────────────────
# Carries threshold-authorized mints to Ethereum. Holds a key for GAS
# ONLY and refuses to start if that key is a registered bridge signer.
# Fund it with enough ETH for gas and nothing more.
SUBMITTER_ETH_KEY=
ETH_RPC_URL=
COORDINATOR_URL=http://localhost:9370
SUBMITTER_POLL_SECS=15
SUBMITTER_RECEIPT_TIMEOUT_SECS=180

# ───────────────────────────────────────────────────────────────────────
# GODSHIELD API + PQ SECURITY GATEWAY  (crates/godshield-api, profile: godshield)
# ───────────────────────────────────────────────────────────────────────
GODSHIELD_PORT=8090
GODSHIELD_ALLOWED_ORIGIN=https://q-lock-ecosystem.com
# Bearer token for gateway admin endpoints (register, rotate, sign).
# At least 32 characters. Blank disables them.
GODSHIELD_ADMIN_TOKEN=
# The gateway's own operational keypair JSON. Enables /gateway/sign
# (attestations about what the gateway checked — never caller bytes).
GODSHIELD_GATEWAY_KEY=
GODSHIELD_POLICY_ID=gw-v1
GODSHIELD_ALLOWED_ALGORITHMS=ML-DSA-87
GODSHIELD_VALUE_LIMIT=0
GODSHIELD_RATE_PER_WINDOW=120
GODSHIELD_RATE_WINDOW_SECS=60

# ───────────────────────────────────────────────────────────────────────
# MONITORING
# ───────────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me-grafana-password

# contracts/.env.example — copy to contracts/.env and fill in.
# Never commit the real .env: it can hold a deployer key.
#
# Matches [rpc_endpoints] / [etherscan] in foundry.toml and the vm.env*
# calls in script/Deploy.s.sol.

# RPC endpoints and verification
ETH_RPC_URL=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Deployer key, passed to forge with --private-key "$PRIVATE_KEY"
# (or use --ledger / --account instead and leave this blank).
# A fresh key funded only for deployment gas — never an admin key.
PRIVATE_KEY=

# Read by script/Deploy.s.sol
# Admin: a multisig or timelock, not an EOA.
BRIDGE_ADMIN=
# Comma-separated signer addresses (at least 3), e.g. 0xabc...,0xdef...,0x123...
BRIDGE_SIGNERS=
# How many must sign (at least 2).
BRIDGE_THRESHOLD=
# Filled in after the stage that deploys each contract.
WNEV_ADDRESS=
BRIDGE_ADDRESS=
# Per-window mint limit in wNEV base units (8 decimals). Minting stays
# disabled until this is set.
MINT_LIMIT_PER_WINDOW=
